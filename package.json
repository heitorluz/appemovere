    "terms:check": "node tooling/checks/terms.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "eslint": "^10.12.0",
    "eslint-plugin-yml": "^3.9.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
