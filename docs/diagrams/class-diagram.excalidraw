      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "NoInsight SAFETY_NET: the review offers help.\nThe use case checks the JournalSafetyNet and\npasses safetyNetHit to the engine.\nPause or hidden numbers: the evaluation runs,\nand the cards wait for the return (shownAt).\nTaking an item off the agenda keeps \"taken\".",
      "roughness": 1,
      "roundness": null,
      "seed": 778122992,
      "strokeColor": "#645E57",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "NoInsight SAFETY_NET: the review offers help.\nThe use case checks the JournalSafetyNet and\npasses safetyNetHit to the engine.\nPause or hidden numbers: the evaluation runs,\nand the cards wait for the return (shownAt).\nTaking an item off the agenda keeps \"taken\".",
      "textAlign": "left",
      "updated": 1791825307224,
      "version": 1,
      "versionNonce": 1050758988,
      "verticalAlign": "top"
    },
