      "index": "am",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "The reviewer never approves on its own: the\nco-author decides, in the Clinical Decision Log.\n\nEvery request produces a trace with tokens, cost,\nlatency and the eval score (spec observability).\n\nThe reviewer API runs on AWS, with Docker,\nTerraform and deployment from CI (spec deploy).",
      "roughness": 1,
      "roundness": null,
      "seed": 1705788106,
      "strokeColor": "#645E57",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "The reviewer never approves on its own: the\nco-author decides, in the Clinical Decision Log.\n\nEvery request produces a trace with tokens, cost,\nlatency and the eval score (spec observability).\n\nThe reviewer API runs on AWS, with Docker,\nTerraform and deployment from CI (spec deploy).",
      "textAlign": "left",
      "updated": 1791825283570,
      "version": 1,
      "versionNonce": 478328548,
      "verticalAlign": "top"
    },
