    {
      "id": "n1",
      "type": "text",
      "x": 260,
      "y": 1310,
      "width": 1642,
      "height": 80,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "am",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Before starting: reassess with Phase 1 data whether Phase 2 is worth it. The fixed template stays the official text; the app never depends on AI.\nPriority: on-device AI. Server only for those without it: it gets only n, means and period from the Pattern, never the journal; server excerpts only with specific consent.\nHypothesis: if there is a server, AWS in the São Paulo region, to avoid international data transfer (an analysis the specification requires).\nThe AI does not interpret, label or advise; the person chooses the emotion and the need.  Source: docs/product (journeys, insights and AI, evals).",
      "roughness": 1,
      "roundness": null,
      "seed": 1705788106,
      "strokeColor": "#645E57",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Before starting: reassess with Phase 1 data whether Phase 2 is worth it. The fixed template stays the official text; the app never depends on AI.\nPriority: on-device AI. Server only for those without it: it gets only n, means and period from the Pattern, never the journal; server excerpts only with specific consent.\nHypothesis: if there is a server, AWS in the São Paulo region, to avoid international data transfer (an analysis the specification requires).\nThe AI does not interpret, label or advise; the person chooses the emotion and the need.  Source: docs/product (journeys, insights and AI, evals).",
      "textAlign": "left",
      "updated": 1791766939914,
      "version": 1,
      "versionNonce": 478328548,
      "verticalAlign": "top"
    },
