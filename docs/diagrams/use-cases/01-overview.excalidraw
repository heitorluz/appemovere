    {
      "id": "n1",
      "type": "text",
      "x": 270,
      "y": 1010,
      "width": 1172,
      "height": 120,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "ax",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Outside the app: the clinical co-author writes and reviews clinical content through the repository (does not use the app).\nAfter personal use: onboarding with store age verification, remote brake, anonymous help counter (diagrams 04 and 06).\nPhase 2, if approved: the AI writes insights from the Pattern and cuts excerpts from thoughts, with consent (diagram 07).\nPhase 3: paid plan, end-to-end backup and small daily actions (diagram 08).\nAI lab (Python repository, on AWS): text reviewer with an agent, MCP, evals and observability (diagram 09).\nSources: docs/product and docs/roadmap/spec-plan.md.",
      "roughness": 1,
      "roundness": null,
      "seed": 1705788106,
      "strokeColor": "#645E57",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Outside the app: the clinical co-author writes and reviews clinical content through the repository (does not use the app).\nAfter personal use: onboarding with store age verification, remote brake, anonymous help counter (diagrams 04 and 06).\nPhase 2, if approved: the AI writes insights from the Pattern and cuts excerpts from thoughts, with consent (diagram 07).\nPhase 3: paid plan, end-to-end backup and small daily actions (diagram 08).\nAI lab (Python repository, on AWS): text reviewer with an agent, MCP, evals and observability (diagram 09).\nSources: docs/product and docs/roadmap/spec-plan.md.",
      "textAlign": "left",
      "updated": 1791665121311,
      "version": 1,
      "versionNonce": 478328548,
      "verticalAlign": "top"
    },
